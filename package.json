{
  "name": "edalat-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Edalat Filter — Automotive Filter & Parts Intelligence Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev --workspace @edalat/web",
    "dev:api": "npm run start:dev --workspace @edalat/api",
    "build": "npm run build --workspace @edalat/shared && npm run build --workspace @edalat/api && npm run build --workspace @edalat/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace @edalat/api",
    "db:migrate": "npm run prisma:migrate --workspace @edalat/api",
    "db:seed": "npm run prisma:seed --workspace @edalat/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
