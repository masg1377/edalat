# PostgreSQL (docker compose up -d starts one on :5432)
DATABASE_URL="postgresql://edalat:edalat@localhost:5432/edalat_filter?schema=public"

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Auth
JWT_ACCESS_SECRET="change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_TTL="30d"
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5

# SMS provider (Kavenegar / SMS.ir / Ghasedak). Leave empty to log OTPs to console.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER=""
SMS_OTP_TEMPLATE="edalat-otp"

# S3-compatible storage (MinIO in development)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="edalat-uploads"
S3_ACCESS_KEY="edalat"
S3_SECRET_KEY="edalat123"
S3_PUBLIC_URL="http://localhost:9000/edalat-uploads"

# Redis
REDIS_URL="redis://localhost:6379"

# Payment gateway (ZarinPal by default)
PAYMENT_GATEWAY="zarinpal"
ZARINPAL_MERCHANT_ID=""
PAYMENT_CALLBACK_URL="http://localhost:4000/payments/callback"
