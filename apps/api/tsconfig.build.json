{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Keep the incremental cache inside the output directory. Left at its
    // default (next to the config) it survives `deleteOutDir`, and the next
    // build then believes everything is up to date and emits nothing.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts", "test"]
}
